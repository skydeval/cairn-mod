# cairn-mod docker-compose configuration.
# Copy to .env and fill in. .env is gitignored — never commit it.

# Public hostname of the labeler. Feeds BOTH:
#  - Caddy's site address (auto-ACME certificate for this name)
#  - service_endpoint (as https://$CAIRN_DOMAIN, set in docker-compose.yml)
CAIRN_DOMAIN=labeler.example.com

# The labeler's DID. Must resolve to a DID document carrying your
# signing key's public half at verification method #atproto_label
# (see SETUP.md).
CAIRN_SERVICE_DID=did:web:labeler.example.com

# Signing key material NEVER goes through env — the CAIRN_SIGNING_KEY
# env var is rejected at startup by design. The key is a bind-mounted
# file (./signing-key.hex, see docker-compose.yml + SETUP.md).

# Complex nested config ([labeler], [operator], [pds_admin.*],
# [label_emission.*], …) lives in the bind-mounted cairn.toml — nested
# TOML tables are file-only under the CAIRN_ env prefix (no nested env
# addressing). See cairn.toml.example.

# --- optional overrides (defaults baked into the image) ---
# CAIRN_BIND_ADDR=0.0.0.0:3000
# CAIRN_DB_PATH=/var/lib/cairn/cairn.db
# CAIRN_SIGNING_KEY_PATH=/var/lib/cairn/signing-key.hex
